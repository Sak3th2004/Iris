MODEL_API_KEY=
IRIS_WORKER_TOKEN=
IRIS_SPEND_LIMIT_USD=149.99
BASETEN_API_KEY=
IRIS_READER_PROVIDER=baseten
# Initial development allowance out of the $100 credit. Hard ceiling: $100.
IRIS_BASETEN_SPEND_LIMIT_USD=10
# Keep loopback binding. Public hosting requires authentication and session isolation.
IRIS_DB=iris.sqlite
# Optional spoken feedback. One AWS account is sufficient; never commit its keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Conservative local reservation allowance, not an AWS invoice.
IRIS_VOICE_ALLOWANCE_USD=2
